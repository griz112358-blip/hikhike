<!--pages/index/index.wxml-->
<view class="container">
  <!-- Logo -->
  <view class="logo">
    <image class="mascot" mode="widthFix" src="https://lc-DNB4W2Wu.cn-n1.lcfile.com/dlldzcTO6ehmKkyQnL0iF0WN2stMwxc8/logo.png"></image>
    <image class="text" src="/assets/images/logo.svg"></image>
  </view>

  <!-- Search Bar -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索路线" value="{{searchText}}" bindinput="onSearchInput" />
    <image class="search-icon" src="/assets/images/icons/search.svg" bindtap="onSearchTap"></image>
  </view>

  <!-- Weekly Hot Recommendations -->
  <view class="section-title">
    <text>热门Top3</text>
    <text class="fire-icon">🔥🔥</text>
  </view>
  <scroll-view class="hot-routes" scroll-x enable-flex="true">
    <view class="route-card" data-name="虎跳峡" bindtap="onRouteTap">
      <image class="route-image" src="https://lc-DNB4W2Wu.cn-n1.lcfile.com/dXCMPNaho5GnpWfutlWWIQWU8dv2CRqu/%E8%99%8E%E8%B7%B3%E5%B3%A1.png"></image>
      <view class="route-info">
        <text class="route-title">虎跳峡</text>
        <text class="route-description">全球十大經典徒步路線</text>
      </view>
    </view>
    <view class="route-card" data-name="熊野古道" bindtap="onRouteTap">
      <image class="route-image" src="https://lc-DNB4W2Wu.cn-n1.lcfile.com/K53vxkNkmdadDlteuBk59NjvXTceaGg8/%E7%86%8A%E9%87%8E%E5%8F%A4%E9%81%93.png"></image>
      <view class="route-info">
        <text class="route-title">熊野古道</text>
        <text class="route-description">日本最受推崇的朝聖路線</text>
      </view>
    </view>
    <view class="route-card" data-name="麦理浩径二段" bindtap="onRouteTap">
      <image class="route-image" src="https://lc-DNB4W2Wu.cn-n1.lcfile.com/8xf0RJlm0Ynmpt5QWEXmVjx7041iBoeB/%E9%BA%A6%E7%90%86%E6%B5%A9%E5%BE%84.png"></image>
      <view class="route-info">
        <text class="route-title">麦理浩径二段</text>
        <text class="route-description">攀登高山、親近海灣，享受動感節奏</text>
      </view>
    </view>
  </scroll-view>

  <!-- Popular Searches -->
  <view class="section-title">
    <text>大家都在搜</text>
  </view>
  <view class="popular-searches">
    <block wx:for="{{popularSearches}}" wx:key="objectId">
      <text class="search-tag" data-id="{{item.objectId}}" bindtap="onCollectionTap">{{item.name}}</text>
    </block>
  </view>

  <!-- Hot Destinations -->
  <view class="section-title">
    <text>江浙沪热门</text>
  </view>
  <scroll-view class="hot-destinations" scroll-x enable-flex="true">
    <view class="destination-card" data-name="光福小七尖" bindtap="onRouteTap">
      <image class="destination-image" src="https://lc-DNB4W2Wu.cn-n1.lcfile.com/UEdeRimAsrW5rzxgQ1FyKuti3gMIuPyl/%E5%85%89%E7%A6%8F%E5%B0%8F%E4%B8%83%E5%B0%96.png"></image>
      <text class="destination-name">苏州 光福小七尖</text>
    </view>
    <view class="destination-card" data-name="花山鱼骨线" bindtap="onRouteTap">
      <image class="destination-image" src="https://lc-DNB4W2Wu.cn-n1.lcfile.com/z6a3Fd4GxBFKFMOPeMJoS8rcLUw50NH7/%E8%8A%B1%E5%B1%B1%E9%B1%BC%E9%AA%A8%E7%BA%BF.png"></image>
      <text class="destination-name">苏州 花山鱼骨线</text>
    </view>
    <view class="destination-card" data-name="穹窿山爱心线" bindtap="onRouteTap">
      <image class="destination-image" src="https://lc-DNB4W2Wu.cn-n1.lcfile.com/H4P1iFhSRkOa9pzX1a8HP8RAXYHnT78p/%E7%A9%B9%E7%AA%BF%E5%B1%B1%E7%88%B1%E5%BF%83%E7%BA%BF.png"></image>
      <text class="destination-name">苏州 穹窿山爱心线</text>
    </view>
    <view class="destination-card" data-name="旺山小环线" bindtap="onRouteTap">
      <image class="destination-image" src="https://lc-DNB4W2Wu.cn-n1.lcfile.com/hFct8SlvfmMCyqylEGtvLXHRSN3kAX2X/%E6%97%BA%E5%B1%B1%E5%B0%8F%E7%8E%AF%E7%BA%BF.png"></image>
      <text class="destination-name">苏州 旺山小环线</text>
    </view>
    <view class="destination-card" data-name="灵白线" bindtap="onRouteTap">
      <image class="destination-image" src="https://lc-DNB4W2Wu.cn-n1.lcfile.com/wrUP0MLwbJOq0bCdRErMieKm0GfTPggi/%E7%81%B5%E7%99%BD%E7%BA%BF.png"></image>
      <text class="destination-name">苏州 灵白线</text>
    </view>
    <view class="destination-card" data-name="虞山小环线" bindtap="onRouteTap">
      <image class="destination-image" src="https://lc-DNB4W2Wu.cn-n1.lcfile.com/lWdvahWM1ors22SVIUvmfXIJtWuWNdlf/%E8%99%9E%E5%B1%B1.png"></image>
      <text class="destination-name">苏州 虞山小环线</text>
    </view>
    <view class="destination-card" data-name="九溪十八涧" bindtap="onRouteTap">
      <image class="destination-image" src="http://lc-DNB4W2Wu.cn-n1.lcfile.com/U9fxnhPgMCr5n71I16WLd9pvMs7qexSn/%E4%B9%9D%E6%BA%AA%E5%8D%81%E5%85%AB%E6%B6%A7.png"></image>
      <text class="destination-name">杭州 九溪十八涧</text>
    </view>
    <view class="destination-card" data-name="渔洋山蝙蝠线" bindtap="onRouteTap">
      <image class="destination-image" src="https://lc-DNB4W2Wu.cn-n1.lcfile.com/BCxcdhzxrRkpKPspc2opckCdptSwghvW/%E6%B8%94%E9%98%B3%E5%B1%B1.png"></image>
      <text class="destination-name">苏州 渔洋山蝙蝠线</text>
    </view>
  </scroll-view>

</view>
