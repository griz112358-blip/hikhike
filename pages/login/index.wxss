.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a3c1f 0%, #2d5a3d 100%);
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
}

.header {
  padding: 120rpx 0 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff;
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50rpx;
  padding: 6rpx;
  margin-bottom: 60rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  border-radius: 44rpx;
  transition: all 0.3s;
}

.tab.active {
  background: #fff;
  color: #1a3c1f;
  font-weight: bold;
}

.tab-content {
  flex: 1;
}

.wechat-login {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.tip {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 60rpx;
}

.login-btn {
  width: 100%;
  height: 90rpx;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-bottom: 20rpx;
}

.wechat-btn {
  background: #07c160;
  color: #fff;
}

.phone-btn {
  background: #fff;
  color: #1a3c1f;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.phone-login {
  padding: 20rpx 0;
}

.form-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  width: 120rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
}

.code-input {
  margin-right: 20rpx;
}

.code-btn {
  padding: 0 24rpx;
  height: 56rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: none;
  border-radius: 8rpx;
  line-height: 56rpx;
}

.code-btn:active {
  background: rgba(255, 255, 255, 0.3);
}

.code-btn[disabled] {
  opacity: 0.5;
}

.footer {
  padding: 40rpx 0;
  text-align: center;
}

.agreement {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.link {
  font-size: 24rpx;
  color: #fff;
}
