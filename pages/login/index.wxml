<view class="login-container">
  <view class="header">
    <image class="logo" src="/assets/images/logo.png" mode="aspectFit"></image>
    <text class="title">HikHike</text>
    <text class="subtitle">探索户外，享受生活</text>
  </view>

  <view class="tabs">
    <view 
      class="tab {{activeTab === 'wechat' ? 'active' : ''}}" 
      data-tab="wechat" 
      bindtap="switchTab"
    >
      微信登录
    </view>
    <view 
      class="tab {{activeTab === 'phone' ? 'active' : ''}}" 
      data-tab="phone" 
      bindtap="switchTab"
    >
      手机号登录
    </view>
  </view>

  <!-- 微信登录 -->
  <view class="tab-content" wx:if="{{activeTab === 'wechat'}}">
    <view class="wechat-login">
      <text class="tip">使用微信账号快速登录</text>
      <button 
        class="login-btn wechat-btn" 
        bindtap="onWeChatLogin"
        loading="{{loading}}"
        disabled="{{loading}}"
      >
        <image class="btn-icon" src="/assets/images/icons/wechat.png" mode="aspectFit"></image>
        微信一键登录
      </button>
    </view>
  </view>

  <!-- 手机号登录 -->
  <view class="tab-content" wx:if="{{activeTab === 'phone'}}">
    <view class="phone-login">
      <view class="form-item">
        <text class="label">手机号</text>
        <input 
          class="input" 
          type="number" 
          maxlength="11" 
          placeholder="请输入手机号"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
      </view>

      <view class="form-item">
        <text class="label">验证码</text>
        <input 
          class="input code-input" 
          type="number" 
          maxlength="4" 
          placeholder="请输入验证码"
          value="{{code}}"
          bindinput="onCodeInput"
        />
        <button 
          class="code-btn" 
          bindtap="onGetCode"
          disabled="{{countdown > 0 || loading}}"
        >
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </button>
      </view>

      <button 
        class="login-btn phone-btn" 
        bindtap="onPhoneLogin"
        loading="{{loading}}"
        disabled="{{loading}}"
      >
        登录
      </button>
    </view>
  </view>

  <view class="footer">
    <text class="agreement">登录即表示同意</text>
    <text class="link">《用户协议》</text>
    <text class="agreement">和</text>
    <text class="link">《隐私政策》</text>
  </view>
</view>
